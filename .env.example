# Copy this file to .env and fill in the values you need.
# Never commit a real API key, database password or secret.

# --- Database -------------------------------------------------------------
POSTGRES_DB=examprep
POSTGRES_USER=examprep
POSTGRES_PASSWORD=change-me

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/examprep
SPRING_DATASOURCE_USERNAME=examprep
SPRING_DATASOURCE_PASSWORD=change-me

# --- Gemini (Google Gen AI Java SDK) --------------------------------------
# Create a key at https://aistudio.google.com/apikey
# Leave empty to run the application; AI actions then report a clear
# "Gemini is not configured" error instead of pretending to work.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_ATTEMPTS=3

# --- Application ----------------------------------------------------------
SERVER_PORT=8080
APP_STORAGE_LOCATION=./data/uploads
APP_MAX_UPLOAD_SIZE_MB=25

# Sessions: enable secure cookies when serving over HTTPS.
SESSION_COOKIE_SECURE=false

# Set to 'framework' when running behind a TLS-terminating reverse proxy.
FORWARD_HEADERS_STRATEGY=none
# Set to false only while editing templates locally.
THYMELEAF_CACHE=true
